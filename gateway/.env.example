# freeoneapi 本地网关配置模板
# 复制成 .env，填自己的 key。.env 绝不提交进仓库（已在 .gitignore 里）。

# 所有源的 key，一个 JSON。只填你有的源，没填的源网关会跳过。
FREEONEAPI_KEYS={"gemini":"你的 Gemini key","groq":"你的 Groq key","openrouter":"你的 OpenRouter key","siliconflow":"你的硅基流动 key","zhipu":"你的智谱 key"}

# 网关密钥：本机监听（127.0.0.1）可空；监听非本机地址时必备，否则网关拒绝启动。
GATEWAY_KEY=

# 动态源的模型显式指定（库里没写死清单的源用这个）。没有就留空 {}。
MODEL_ROUTES={}

# 端口与监听地址。默认只绑本机，别改成 0.0.0.0，除非你知道自己在做什么。
PORT=8080
HOST=127.0.0.1

# 库地址。默认 Pages 上的 providers.json；也可指向本地文件路径。
# PROVIDERS_URL=https://benfennet.github.io/freeoneapi/providers.json
